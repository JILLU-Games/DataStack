# DataStack Environment Variables Configuration
# NOTE: In production (NODE_ENV=production), replace all placeholder values below with strong 32+ char secrets.

# Security & Session Secrets (REQUIRED in production, min 32 characters)
DATASTACK_ADMIN_SESSION_SECRET=replace-with-32-plus-char-admin-session-secret
DATASTACK_JWT_SECRET=replace-with-32-plus-char-client-jwt-secret
DATASTACK_ADMIN_SETUP_KEY=replace-with-32-plus-char-admin-setup-key
DATASTACK_INTERNAL_SECRET=replace-with-32-plus-char-internal-service-secret

# Administrator Account (development/in-memory bootstrap; production uses /vcon/setup)
DATASTACK_ADMIN_EMAIL=admin@datastack.dev
# DATASTACK_ADMIN_PASSWORD=replace-with-strong-password
# DATASTACK_ALLOW_DEMO_ADMIN=false

# PostgreSQL Database (recommended for production persistence)
# DATABASE_URL=postgresql://datastack:password@localhost:5432/datastack_db

# Shared Redis Buffer (optional; enables cross-process buffering & distributed flush locks)
# REDIS_URL=redis://127.0.0.1:6379

# Shared Partitioned CSV Storage Directory (optional; defaults to ./storage/data)
# Set an absolute path so Port 3000 (Next.js) and Port 4000 (Ingestion) always share one storage root
# DATASTACK_STORAGE_DIR=/var/lib/datastack/storage/data

# Service Networking
PORT_SOCKET=4000
INGESTION_INTERNAL_URL=http://127.0.0.1:4000
# Optional comma-separated browser CORS origin allowlist for Port 4000 ingestion/Socket.IO (defaults to wildcard if unset)
# DATASTACK_CORS_ORIGINS=https://console.example.com,https://admin.example.com
# Outbound SSRF protection blocks loopback/private/internal URLs by default for webhooks & S3 endpoints.
# Set to true ONLY if intentionally targeting a self-hosted LAN MinIO or private webhook endpoint (cloud metadata IPs remain always blocked).
# DATASTACK_ALLOW_PRIVATE_URLS=false

# Ingestion Batch Array Guard (default: 1000 items per HTTP POST /api/events batch or Socket.IO batch_sync frame; bounded 1..10000)
# DATASTACK_MAX_BATCH_ITEMS=1000