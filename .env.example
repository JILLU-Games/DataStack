# DataStack Environment Variables Configuration

# Administrator Account (defaults to admin@datastack.dev / admin12345678 if omitted)
DATASTACK_ADMIN_EMAIL=admin@datastack.dev
DATASTACK_ADMIN_PASSWORD=admin12345678

# Security & Session Secrets (min 32 characters)
DATASTACK_ADMIN_SESSION_SECRET=datastack-admin-session-default-secret-32-chars
DATASTACK_JWT_SECRET=datastack-jwt-default-secret-key-32-chars-long
DATASTACK_ADMIN_SETUP_KEY=datastack-default-setup-key-32-chars

# PostgreSQL Database (optional - in-memory fallback active when not configured)
# DATABASE_URL=postgresql://datastack:password@localhost:5432/datastack_db

# Ingestion Engine Port (defaults to 4000)
PORT_SOCKET=4000