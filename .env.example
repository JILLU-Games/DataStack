# Optional settings for other hosting integrations; Coolify Compose does not require them.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Coolify auto-generates these values from docker-compose.yml magic variables:
# SERVICE_HEX_32_DATABASENAME
# SERVICE_PASSWORD_64_POSTGRES
# SERVICE_REALBASE64_64_JWT
# SERVICE_REALBASE64_64_ADMINSESSION
# SERVICE_REALBASE64_64_ADMININSTALL
# They are not entered here. JWT/session/admin secrets can be rotated in Coolify.
# PostgreSQL name/password are generated once and persist. Password rotation also requires changing the DB role.
# The install key is required only for the first admin setup; setup closes after first account creation.
# The only required manual value for Coolify is the administrator's email:
DATASTACK_ADMIN_EMAIL=
